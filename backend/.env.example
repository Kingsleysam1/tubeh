# TubeHeist Backend Environment Variables
# Copy this file to .env and fill in your values.

# API authentication token (optional — leave empty to disable auth in dev)
API_TOKEN=

# Server port (Render sets this automatically)
PORT=5000

# Flask environment
FLASK_ENV=development

# ── YouTube Cookie Authentication ─────────────────────────────────
# Paste the full content of your Netscape cookies.txt file here.
# Export from browser using "Get cookies.txt LOCALLY" extension.
# Filter to .youtube.com and .google.com domains.
# The backend writes this to /tmp/youtube_cookies.txt on startup.
# Supports raw Netscape text or base64-encoded.
YOUTUBE_COOKIES=

# Alternative: Path to a mounted cookies file (e.g., Docker volume)
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt

# ── Proxy (Tier 3 — Optional) ────────────────────────────────────
# HTTP or SOCKS5 proxy URL for yt-dlp requests.
# Example: socks5://user:pass@proxy.example.com:1080
# PROXY_URL=
